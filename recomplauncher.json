{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Monado (Xenoblade Chronicles: Definitive Edition)",
  "repo": "Ivanprestef2/Monado-FIX-Portable",
  "game": {
    "kind": "folder",
    "label": "Your own copy of Xenoblade Chronicles: Definitive Edition 2.0.0 (base game with the update applied), extracted to plain folders: pick the folder that holds exefs and romfs.",
    "check": { "file": "exefs/main" }
  },
  "start": {
    "program": ["build/xcde.exe"],
    "args": ["--game", "{game}"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{install}/xcde.ini" }]
    }
  ],
  "folders": {
    "saves": [{ "path": "{install}/save" }],
    "logs": [{ "path": "{install}/build" }]
  },
  "saves": ["{install}/save", "{install}/xcde.ini"],
  "settings": [
    {
      "id": "fullscreen", "label": "Window",
      "help": "Fullscreen fills your screen. Windowed uses the window size below.",
      "choices": [
        { "label": "Windowed", "set": { "fullscreen": "0" } },
        { "label": "Fullscreen", "set": { "fullscreen": "1" } }
      ],
      "defaults": { "fullscreen": "0" }
    },
    {
      "id": "window_size", "label": "Window size",
      "help": "The size of the game's window in Windowed mode.",
      "choices": [
        { "label": "1280 x 720", "set": { "window": "1280x720" } },
        { "label": "1600 x 900", "set": { "window": "1600x900" } },
        { "label": "1920 x 1080", "set": { "window": "1920x1080" } },
        { "label": "2560 x 1440", "set": { "window": "2560x1440" } },
        { "label": "3840 x 2160", "set": { "window": "3840x2160" } }
      ],
      "defaults": { "window": "1280x720", "fullscreen": "0" },
      "when": { "fullscreen": "0" }
    },
    {
      "id": "frame_rate", "label": "Frame rate",
      "help": "The Switch game runs at 30. Higher rates are smoother but can affect some animations.",
      "choices": [
        { "label": "30", "set": { "fps": "30" } },
        { "label": "60", "set": { "fps": "60" } },
        { "label": "120", "set": { "fps": "120" } },
        { "label": "144", "set": { "fps": "144" } },
        { "label": "165", "set": { "fps": "165" } },
        { "label": "Unlimited", "set": { "fps": "unlimited" } }
      ],
      "defaults": { "fps": "30" }
    },
    {
      "id": "resolution", "label": "Resolution",
      "help": "What the game draws at. 720p is the Switch's own. More is sharper and needs a faster graphics card.",
      "choices": [
        { "label": "Match the window", "set": { "resolution": "match" } },
        { "label": "720p", "set": { "resolution": "1" } },
        { "label": "1440p", "set": { "resolution": "2" } },
        { "label": "4K", "set": { "resolution": "3" } },
        { "label": "75% of the window", "set": { "resolution": "75%" } },
        { "label": "50% of the window", "set": { "resolution": "50%" } },
        { "label": "Dynamic", "set": { "resolution": "dynamic" } }
      ],
      "defaults": { "resolution": "match" }
    },
    {
      "id": "upscaler", "label": "Upscaling",
      "help": "DLSS needs an NVIDIA RTX card. FSR 3.1 works on any card. Auto picks for your PC.",
      "choices": [
        { "label": "Auto", "set": { "upscaler": "auto" } },
        { "label": "Bilinear", "set": { "upscaler": "bilinear" } },
        { "label": "FSR 1", "set": { "upscaler": "fsr" } },
        { "label": "FSR 3.1", "set": { "upscaler": "fsr3" } },
        { "label": "DLSS", "set": { "upscaler": "dlss" } }
      ],
      "defaults": { "upscaler": "auto" }
    },
    {
      "id": "upscale_quality", "label": "Upscaling quality",
      "help": "How low the game renders before FSR 3.1 or DLSS rebuild the picture. Lower is faster.",
      "choices": [
        { "label": "Native", "set": { "upscale_quality": "native" } },
        { "label": "Quality", "set": { "upscale_quality": "quality" } },
        { "label": "Balanced", "set": { "upscale_quality": "balanced" } },
        { "label": "Performance", "set": { "upscale_quality": "performance" } },
        { "label": "Ultra performance", "set": { "upscale_quality": "ultra" } }
      ],
      "defaults": { "upscale_quality": "quality" }
    },
    {
      "id": "frame_gen", "label": "Frame generation",
      "help": "FSR 3 frame generation adds frames between the real ones. Needs FSR 3.1 upscaling.",
      "choices": [
        { "label": "Off", "set": { "frame_gen": "0" } },
        { "label": "On", "set": { "frame_gen": "1" } }
      ],
      "defaults": { "frame_gen": "0" }
    },
    {
      "id": "antialias", "label": "Anti-aliasing",
      "help": "SMAA smooths jagged edges at a small cost.",
      "choices": [
        { "label": "Off", "set": { "antialias": "off" } },
        { "label": "SMAA", "set": { "antialias": "smaa" } }
      ],
      "defaults": { "antialias": "off" }
    },
    {
      "id": "vsync", "label": "V-Sync",
      "help": "Waits for the screen's refresh at 30 and 60 FPS, so there is no tearing.",
      "choices": [
        { "label": "On", "set": { "vsync": "1" } },
        { "label": "Off", "set": { "vsync": "0" } }
      ],
      "defaults": { "vsync": "1" }
    },
    {
      "id": "aspect", "label": "Aspect ratio",
      "help": "Auto fills your screen, including ultrawide. Original keeps the Switch's 16:9.",
      "choices": [
        { "label": "Auto", "set": { "aspect": "auto" } },
        { "label": "Original 16:9", "set": { "aspect": "original" } }
      ],
      "defaults": { "aspect": "auto" }
    },
    {
      "id": "fps_overlay", "label": "Show FPS",
      "help": "The frame rate in a corner of the game.",
      "choices": [
        { "label": "On", "set": { "fps_overlay": "1" } },
        { "label": "Off", "set": { "fps_overlay": "0" } }
      ],
      "defaults": { "fps_overlay": "1" }
    },
    {
      "id": "language", "label": "Game language",
      "help": "The language of the game's text and voices. Auto uses English.",
      "choices": [
        { "label": "Auto", "set": { "language": "auto" } },
        { "label": "English", "set": { "language": "en-US" } },
        { "label": "Spanish", "set": { "language": "es" } },
        { "label": "French", "set": { "language": "fr" } },
        { "label": "German", "set": { "language": "de" } },
        { "label": "Italian", "set": { "language": "it" } },
        { "label": "Japanese", "set": { "language": "ja" } },
        { "label": "Korean", "set": { "language": "ko" } },
        { "label": "Chinese (Simplified)", "set": { "language": "zh-Hans" } },
        { "label": "Chinese (Traditional)", "set": { "language": "zh-Hant" } }
      ],
      "defaults": { "language": "auto" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your save files.", "open": "saves" },
    { "id": "logs", "label": "Logs", "help": "The game's logs, useful when reporting a problem.", "open": "logs" }
  ]
}
